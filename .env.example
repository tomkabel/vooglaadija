# ============================================
# Vooglaadija — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#   # edit .env with your secrets
#   ./scripts/preflight-check.sh
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d
# ============================================

# ── Required: Database ──────────────────────
# PostgreSQL superuser password (used for both the DB container and app connection)
DB_PASSWORD=change-me-to-a-secure-password

# ── Required: Redis ─────────────────────────
# Redis password (used for both the Redis container and app connection)
REDIS_PASSWORD=change-me-to-another-secure-password

# ── Required: Security ──────────────────────
# Flask/FastAPI secret key for JWT and session signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret-key

# ── Optional: Database ──────────────────────
# DB_USER=postgres
# DB_NAME=ytprocessor
# DB_HOST=db
# DB_PORT=5432

# ── Optional: Redis ─────────────────────────
# REDIS_HOST=redis
# REDIS_PORT=6379

# ── Optional: File Storage ──────────────────
# FILE_EXPIRE_HOURS=24
# STORAGE_PATH=/app/storage

# ── Optional: Networking ────────────────────
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8081,http://127.0.0.1:8080

# ── Optional: Observability ─────────────────
# FEATURE_METRICS_ENABLED=true
# FEATURE_TRACING_ENABLED=true
# FEATURE_CHAOS_API_ENABLED=false

# ============================================
# Vooglaadija — Environment Configuration
# ============================================
# Production (recommended): deploy/bootstrap.sh asks for the domain and a
# Cloudflare API token, provisions Docker + Coolify, generates these secrets
# and stores them encrypted in Coolify. You do NOT need a local .env for the
# Coolify-managed deployment.
#
# Local development / standalone compose:
#
#   cp .env.example .env
#   # edit .env with local secrets; never commit .env or .env.local
#   ./scripts/preflight-check.sh
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
#
# Secret generation:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Use the generated value for SECRET_KEY. Choose new, unique DB_PASSWORD
# and REDIS_PASSWORD values for each local or deployment environment.
#
# Rotation notes:
#
# - Rotate SECRET_KEY, DB_PASSWORD outside git. During SECRET_KEY rollout, set
#   SECRET_KEY_PREVIOUS to the old key for up to 24 hours so existing JWTs
#   continue to verify, then clear it.
# ============================================

# ── Required: Database ──────────────────────
# PostgreSQL password used by the DB container and app connection.
DB_PASSWORD=change-me-db-password

# ── Required: Redis ─────────────────────────
# Redis password used by the Redis container and app connection.
REDIS_PASSWORD=change-me-redis-password

# ── Required: Security ──────────────────────
# FastAPI secret key for JWT signing. Replace before startup.
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-64
# Optional temporary previous JWT signing key for 24-hour rotation transition.
# Leave empty during steady state and clear after rollout completes.
SECRET_KEY_PREVIOUS=

# ── Optional: Database ──────────────────────
# DB_USER=postgres
# DB_NAME=ytprocessor
# DB_HOST=db
# DB_PORT=5432
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# Worker pool overrides:
# WORKER_DB_POOL_SIZE=3
# WORKER_DB_MAX_OVERFLOW=2
# WORKER_CONCURRENCY=2
# WORKER_REPLICAS=1

# ── Optional: Redis ─────────────────────────
# REDIS_HOST=redis
# REDIS_PORT=6379

# ── Optional: File Storage ──────────────────
# FILE_EXPIRE_HOURS=24
# STORAGE_PATH=/app/storage

# ── Optional: Networking / Domain ───────────
# Used by deploy/bootstrap.sh and the production CORS origin.
# Cookies require HTTPS by default (COOKIE_SECURE=True in production). Local
# dev over plain HTTP must explicitly disable secure cookies:
COOKIE_SECURE=False
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8081,http://127.0.0.1:8080
DEPLOY_DOMAIN=example.com

# ── Optional: Browser downloader (Phase 2) ──
# Routes TikTok/Instagram/Twitter downloads to the browser-downloader
# microservice (compose service `browser-downloader`). Disable to force
# everything through yt-dlp.
# BROWSER_DOWNLOADER_ENABLED=true
# BROWSER_DOWNLOADER_ENDPOINT=http://browser-downloader:3000
# BD_REQUEST_TIMEOUT_MS=300000

# ── Optional: Image tags (Coolify / CI) ─────
# The api/worker images are pulled from GHCR. Leave as latest for
# auto-deploys; pin to a commit SHA for a fixed release.
# IMAGE_TAG=latest

# ── Optional: Observability ─────────────────
# Local compose defaults send app telemetry to the in-stack collector. Override
# this endpoint in production with the collector's OTLP/gRPC backend target.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Keep TLS verification enabled for production backends. Set true only for
# explicitly local/dev OTLP targets without TLS.
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=vooglaadija
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4317/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4317/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4317/v1/logs
FEATURE_METRICS_ENABLED=true
FEATURE_TRACING_ENABLED=true
FEATURE_CHAOS_API_ENABLED=false
FEATURE_THROTTLE_PREEMPTIVE_ENABLED=false

# ── Optional: Monitoring profile (Prometheus + Grafana) ──
# docker compose --profile monitoring up -d
# Grafana dashboard credentials. Replace in local/deployment env files;
# deploy/bootstrap.sh generates a random password for production.
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-admin-password
GF_SECURITY_ADMIN_USER=admin

# ── Optional: Backup profile (PostgreSQL dumps) ──────────
# docker compose --profile backup up -d
# BACKUP_RETENTION_DAYS=7

# ── Optional: NetData (external monitoring, optional) ────
# NETDATA_CLAIM_TOKEN=change-me-netdata-cloud-claim-token
# NETDATA_CLAIM_URL=https://app.netdata.cloud
# NETDATA_CLAIM_ROOMS=change-me-netdata-room-id

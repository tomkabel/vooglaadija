# ============================================
# Vooglaadija — Environment Configuration
# ============================================
# Local setup:
#
#   cp .env.example .env
#   # edit .env with local-only secrets; never commit .env or .env.local
#   ./scripts/preflight-check.sh
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d
#
# Secret generation:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Use the generated value for SECRET_KEY. Choose new, unique DB_PASSWORD
# and REDIS_PASSWORD values for each local or deployment environment. For
# Netdata, create a new claim token in Netdata Cloud and store it only in
# the runtime secret source or your local .env.
#
# Rotation notes:
#
# - Rotate SECRET_KEY, DB_PASSWORD, and NETDATA_CLAIM_TOKEN outside git.
# - Retire old values after rollout; existing JWTs may be invalidated until
#   dual-key transition support is implemented.
# - Production should receive secrets from the deployment/runtime secret
#   source, not from a committed file.
# ============================================

# ── Required: Database ──────────────────────
# PostgreSQL password used by the DB container and app connection.
DB_PASSWORD=change-me-db-password

# ── Required: Redis ─────────────────────────
# Redis password used by the Redis container and app connection.
REDIS_PASSWORD=change-me-redis-password

# ── Required: Security ──────────────────────
# FastAPI secret key for JWT signing. Replace before startup.
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-64

# ── Optional: Database ──────────────────────
# DB_USER=postgres
# DB_NAME=ytprocessor
# DB_HOST=db
# DB_PORT=5432

# ── Optional: Redis ─────────────────────────
# REDIS_HOST=redis
# REDIS_PORT=6379

# ── Optional: File Storage ──────────────────
# FILE_EXPIRE_HOURS=24
# STORAGE_PATH=/app/storage

# ── Optional: Networking ────────────────────
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8081,http://127.0.0.1:8080

# ── Optional: Observability ─────────────────
# Netdata Cloud claim values. Keep token local; leave placeholders unchanged
# until claiming nodes with scripts/install-netdata.sh or scripts/claim-netdata.sh.
NETDATA_CLAIM_TOKEN=change-me-netdata-cloud-claim-token
NETDATA_CLAIM_URL=https://app.netdata.cloud
NETDATA_CLAIM_ROOMS=change-me-netdata-room-id
NETDATA_CLAIM_ROOM=change-me-netdata-room-id

# FEATURE_METRICS_ENABLED=true
# FEATURE_TRACING_ENABLED=true
# FEATURE_CHAOS_API_ENABLED=false

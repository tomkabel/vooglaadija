      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(ytprocessor_job_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(ytprocessor_job_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(ytprocessor_job_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 44
      },
      "type": "stat",
      "title": "Throttle Risk",
      "description": "YouTube throttle risk (0=low, 0.5=elevated, 0.8=high, 1=blocked) -- pumps before 429 errors hit the user",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "0": {
                  "type": "range",
                  "options": {
                    "from": 0,
                    "to": 0.5,
                    "result": {
                      "text": "LOW",
                      "color": "green"
                    }
                  }
                },
                "0.5": {
                  "type": "range",
                  "options": {
                    "from": 0.5,
                    "to": 0.8,
                    "result": {
                      "text": "ELEVATED",
                      "color": "orange"
                    }
                  }
                },
                "0.8": {
                  "type": "range",
                  "options": {
                    "from": 0.8,
                    "to": 1.0,
                    "result": {
                      "text": "HIGH",
                      "color": "red"
                    }
                  }
                },
                "1.0": {
                  "type": "range",
                  "options": {
                    "from": 1.0,
                    "to": 1.0,
                    "result": {
                      "text": "BLOCKED",
                      "color": "purple"
                    }
                  }
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              },
              {
                "color": "purple",
                "value": 1.0
              }
            ]
          },
          "unit": "none"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "textMode": "value_and_name",
        "text": {
          "titleSize": 36,
          "valueSize": 36
        }
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "ytprocessor_throttle_risk_score{service=\"youtube\", provider=\"youtube\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
